# ===== Obrigatorios (o aplicar_gestao_ti.sh gera valores aleatorios) =====
DB_PASSWORD=troque-esta-senha
AGENT_KEY=troque-esta-chave
SECRET_KEY=troque-esta-chave-de-sessao
ADMIN_USER=admin
ADMIN_NOME=Administrador TI
ADMIN_PASSWORD=troque-esta-senha
# Adm geral: alem do usuario local acima, logins do AD (separados por virgula) que tem todos os modulos
# e sao os unicos que autorizam outras pessoas a conceder permissoes. Ex.: ADMIN_GERAL=bernardo.medeiros
ADMIN_GERAL=

# Porta publicada e endereco da Gestao TI (tambem usado pelo script do Wi-Fi nas estacoes)
PORTA=8090
PAINEL_URL=http://localhost:8090

# true quando o painel estiver atras de HTTPS (proxy reverso)
COOKIE_SEGURO=false
SESSAO_HORAS=12

# ===== Login pelo Active Directory =====
AD_HABILITADO=true
AD_SERVIDORES=10.1.100.2,10.1.100.3
AD_DOMINIO=santaluzia.int
AD_BASE_DN=DC=santaluzia,DC=int
# Quem e da EQUIPE DA TI (recebe todos os modulos no primeiro acesso e pode receber os modulos restritos):
# usuarios dentro desta OU (inclui sub-OUs)...
AD_OU_PERMITIDA=OU=Infra,OU=Tecnologia da Informatica,OU=Administracao e Gestao de Pessoas,OU=SantaLuzia,DC=santaluzia,DC=int
# ...e/ou membros deste grupo (DN completo do grupo; deixe vazio se usar so a OU)
AD_GRUPO_PERMITIDO=
# Seguranca da conexao com o AD: auto (LDAPS 636, depois StartTLS 389) | ldaps | starttls | nenhuma
AD_SEGURANCA=auto
# Se os DCs nao tiverem certificado, permita a conexao sem criptografia (a senha trafega aberta na rede interna)
AD_PERMITIR_SEM_TLS=false
AD_VALIDAR_CERTIFICADO=false
# Conta de servico so de leitura. NECESSARIA para o modulo "E-mails para usuarios do AD" (listar todos os e-mails)
# e para buscar pessoas ao dar permissoes. Ex.: AD_BIND_USUARIO=svc_gestaoti
AD_BIND_USUARIO=
AD_BIND_SENHA=
# Conta para o modulo Reset de senha (opcional; se vazia, usa a conta de servico acima).
# Precisa da permissao delegada "Redefinir senha" nas OUs dos usuarios e de conexao LDAPS/StartTLS com os DCs.
AD_RESET_USUARIO=
AD_RESET_SENHA=
# Conta desativada e sem uso ha mais de N dias: reativar so com processo SEI (a TI confirma na tela)
DIAS_REATIVACAO_SEI=90
# Usuario local "admin": acesso de emergencia se o AD estiver fora do ar
LOGIN_LOCAL_HABILITADO=true

# ===== Nomes exibidos =====
APP_NOME=Gestão TI
APP_SUBTITULO=Central de Gestão de Tecnologia da Informação
WIFI_NOME=Acesso à Rede Sem Fio
WIFI_SUBTITULO=Sistema de Autorização de Acesso à Rede Sem Fio
ORGAO_LINHA1=Prefeitura Municipal de
ORGAO_LINHA2=Santa Luzia
RODAPE=Desenvolvido pela Secretaria de Planejamento, Ciência, Tecnologia e Inovação

# ===== Regras =====
# Opcoes de tempo que o usuario pode pedir no portal: em horas e em dias (as duas listas aparecem juntas)
HORAS_PERMITIDAS=1,2,4,8
DIAS_PERMITIDOS=1,2,3,5,7
# Tempo personalizado no portal (o usuario digita a quantidade e escolhe horas ou dias), ate HORAS_MAXIMAS_USUARIO
PERSONALIZADO_USUARIO=true
HORAS_MAXIMAS_USUARIO=720
# Opcoes de tempo oferecidas a TI, em horas e em dias (a TI sempre pode usar "Personalizado")
HORAS_ADMIN=1,2,4,8,12
DIAS_ADMIN=1,2,3,7,15,30
# Maximo, em horas, que a TI pode liberar de uma vez (720 = 30 dias)
HORAS_MAXIMAS=720
# Permite liberar por tempo indeterminado (ate a TI bloquear)
PERMITIR_INDETERMINADO=true
# Pedidos por computador ou usuario a cada 24 horas
MAX_SOLICITACOES_POR_DIA=5
# Identificacao do computador no portal: alem do IP informado pelo script da GPO,
# tenta o DNS reverso (PTR) do AD. Funciona se existir a zona reversa no DNS.
DETECTAR_POR_DNS=true
DNS_SERVIDORES=10.1.100.2,10.1.100.3
# IPs de proxy reverso confiavel (deixe 127.0.0.1 se acessar direto pela porta)
FORWARDED_ALLOW_IPS=127.0.0.1

# ===== Notificacoes (opcionais, deixe vazio para desativar) =====
# Telegram: token do bot e um ou mais chat_id separados por virgula
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp pela Evolution API
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_APIKEY=
# Numeros com DDI e DDD, separados por virgula (ex.: 5531999999999)
WHATSAPP_NUMEROS=


# ===== Servidor de e-mail (SMTP) - disparos em lote =====
# Tambem da para configurar pela tela, no modulo Configuracoes (o que for salvo la vale no lugar destes valores).
# Para TESTE LOCAL use o Mailpit (servidor falso, nada sai de verdade, veja em http://localhost:8025):
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_TLS=false  SMTP_SSL=false  (usuario e senha vazios)
# Em producao: o servidor da prefeitura. Porta 587 com SMTP_TLS=true, ou 465 com SMTP_SSL=true.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=false
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=geral@santaluzia.mg.gov.br
SMTP_FROM_NOME=Prefeitura Municipal de Santa Luzia
# Pausa entre um e-mail e outro (milissegundos). 200 = cerca de 300 e-mails por minuto
ENVIO_PAUSA_MS=200
# Soma maxima dos anexos de um disparo (MB), tamanho maximo de cada imagem dentro da mensagem (MB)
# e maximo de e-mails por disparo. Lembre: cada destinatario recebe uma copia dos anexos.
ANEXOS_MAX_MB=10
IMAGEM_MAX_MB=3
LISTA_MAX_EMAILS=50000
